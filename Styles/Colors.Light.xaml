<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== ПАЛИТРА (СВЕТЛАЯ) ==================== -->
    <!-- Аква #72EDF2 и индиго #5151E5 + производные -->

    <!-- Акценты -->
    <Color x:Key="CoralColor">#FF5151E5</Color>
    <!-- индиго вместо коралла -->
    <Color x:Key="CrimsonColor">#FF3F3FCC</Color>
    <!-- темнее индиго -->
    <Color x:Key="BurgundyColor">#FF6E6EEE</Color>
    <!-- светлее индиго -->
    <Color x:Key="PurpleColor">#FF8A8AF2</Color>
    <!-- ещё светлее -->
    <Color x:Key="DarkColor">#FF72EDF2</Color>
    <!-- аква как «тёмный» край градиента -->

    <!-- Текст: на светлом фоне — почти чёрный -->
    <Color x:Key="TextColor">#FF1A1A2E</Color>
    <Color x:Key="MutedText">#FF5C5C7A</Color>

    <!-- Поверхности: полупрозрачный белый -->
    <Color x:Key="SurfaceColor">#B3FFFFFF</Color>
    <Color x:Key="SurfaceSoftColor">#66FFFFFF</Color>
    <Color x:Key="SurfaceDeepColor">#FFE8ECF5</Color>

    <!-- Игровое поле -->
    <Color x:Key="BoardBgColor">#FFF0F6FF</Color>
    <Color x:Key="CellClosedColor">#FFD6E1F5</Color>
    <Color x:Key="CellOpenColor">#80FFFFFF</Color>
    <Color x:Key="CellFlaggedColor">#FF5151E5</Color>

    <!-- Крестики-нолики -->
    <Color x:Key="XColor">#FF5151E5</Color>
    <Color x:Key="OColor">#FF2AA6B8</Color>

    <!-- Полупрозрачные элементы UI -->
    <Color x:Key="OverlayWeak">#33000000</Color>
    <Color x:Key="OverlayMedium">#55000000</Color>

    <!-- ==================== КИСТИ (тот же набор ключей!) ==================== -->
    <SolidColorBrush x:Key="CoralBrush"    Color="{StaticResource CoralColor}"/>
    <SolidColorBrush x:Key="CrimsonBrush"  Color="{StaticResource CrimsonColor}"/>
    <SolidColorBrush x:Key="BurgundyBrush" Color="{StaticResource BurgundyColor}"/>
    <SolidColorBrush x:Key="PurpleBrush"   Color="{StaticResource PurpleColor}"/>
    <SolidColorBrush x:Key="DarkBrush"     Color="{StaticResource DarkColor}"/>

    <SolidColorBrush x:Key="TextBrush"      Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedText}"/>
    <SolidColorBrush x:Key="AccentBrush"    Color="{StaticResource CoralColor}"/>

    <SolidColorBrush x:Key="SurfaceBrush"     Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{StaticResource SurfaceSoftColor}"/>
    <SolidColorBrush x:Key="SurfaceDeepBrush" Color="{StaticResource SurfaceDeepColor}"/>

    <SolidColorBrush x:Key="BoardBgBrush"     Color="{StaticResource BoardBgColor}"/>
    <SolidColorBrush x:Key="CellClosedBrush"  Color="{StaticResource CellClosedColor}"/>
    <SolidColorBrush x:Key="CellOpenBrush"    Color="{StaticResource CellOpenColor}"/>
    <SolidColorBrush x:Key="CellFlaggedBrush" Color="{StaticResource CellFlaggedColor}"/>

    <SolidColorBrush x:Key="XBrush" Color="{StaticResource XColor}"/>
    <SolidColorBrush x:Key="OBrush" Color="{StaticResource OColor}"/>

    <SolidColorBrush x:Key="OverlayWeakBrush"   Color="{StaticResource OverlayWeak}"/>
    <SolidColorBrush x:Key="OverlayMediumBrush" Color="{StaticResource OverlayMedium}"/>

    <!-- Градиенты -->
    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF72EDF2" Offset="0"/>
        <GradientStop Color="#FF8DA8F0" Offset="0.5"/>
        <GradientStop Color="#FF5151E5" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5151E5" Offset="0"/>
        <GradientStop Color="#FF72EDF2" Offset="1"/>
    </LinearGradientBrush>

    <!-- Змейка: голова — индиго, хвост — аква -->
    <LinearGradientBrush x:Key="SnakeHeadBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5151E5" Offset="0"/>
        <GradientStop Color="#FF72EDF2" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>