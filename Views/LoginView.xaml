<UserControl x:Class="gamelibrary4.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1120">

    <Grid>
        <!-- Декоративные круги на фоне -->
        <Ellipse Width="500" Height="500" Fill="{DynamicResource CoralBrush}" Opacity="0.15"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-150,-150,0,0"/>
        <Ellipse Width="400" Height="400" Fill="{DynamicResource CrimsonBrush}" Opacity="0.15"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-100,-100"/>

        <!-- Карточка входа -->
        <Border Width="420"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CoralBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="40,36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#EE4540" BlurRadius="40" ShadowDepth="0" Opacity="0.25"/>
            </Border.Effect>

            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="🎮" FontSize="42" HorizontalAlignment="Center"/>
                <TextBlock Text="Мини-Игры"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
                <TextBlock x:Name="SubtitleText"
                           Text="Войдите, чтобы продолжить"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,28"/>

                <!-- Логин -->
                <TextBlock Text="Логин" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="4,0,0,6"/>
                <Border Background="{DynamicResource OverlayWeakBrush}" CornerRadius="12" Padding="12,2" Margin="0,0,0,14">
                    <TextBox x:Name="LoginBox"
                             Text=""
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{StaticResource CoralBrush}"
                             FontSize="15"
                             Padding="4,10"/>
                </Border>

                <!-- Пароль -->
                <TextBlock Text="Пароль" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="4,0,0,6"/>
                <Border Background="{DynamicResource OverlayWeakBrush}" CornerRadius="12" Padding="12,2" Margin="0,0,0,10">
                    <PasswordBox x:Name="PasswordBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{StaticResource CoralBrush}"
                                 FontSize="15"
                                 Padding="4,10"/>
                </Border>

                <!-- Ошибка -->
                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource CoralBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="4,4,4,10"
                           Visibility="Collapsed"/>

                <!-- Кнопка войти -->
                <Button x:Name="LoginButton"
                        Content="Войти"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,12"
                        FontSize="14"
                        Margin="0,6,0,0"
                        Click="LoginButton_Click"/>

                <!-- Разделитель -->
                <Grid Margin="0,20,0,14">
                    <Rectangle Height="1" Fill="#33FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="#662D142C" Padding="10,0" HorizontalAlignment="Center">
                        <TextBlock Text="или" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </Border>
                </Grid>

                <!-- Регистрация -->
                <Button x:Name="RegisterButton"
                        Content="Создать аккаунт"
                        Style="{StaticResource FlatButton}"
                        Padding="20,12"
                        FontSize="14"
                        Click="RegisterButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>