<UserControl x:Class="gamelibrary4.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid>
        <!-- Заголовок -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0">
            <TextBlock Text="Выбери игру"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Быстро переключи мозг на пару минут"
                       FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Круговое кольцо -->
        <Grid x:Name="RingRoot" Width="520" Height="520"
              HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Внешнее кольцо -->
            <Ellipse Width="500" Height="500"
                     Stroke="#337C9CFF" StrokeThickness="1.5"
                     StrokeDashArray="2 6"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="OuterRotation" Angle="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Внутреннее кольцо -->
            <Ellipse Width="420" Height="420"
                     Stroke="{DynamicResource CoralBrush}" Opacity="0.3" StrokeThickness="1"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="InnerRotation" Angle="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Кнопки игр -->
            <Canvas x:Name="RingCanvas" Width="520" Height="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Центральная панель -->
            <Border Width="200" Height="200" CornerRadius="100"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CoralBrush}" BorderThickness="1.5">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="CenterTitle" Text="Игры"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CenterSubtitle" Text="7 доступно"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"/>
                    <Button x:Name="PlayButton" Content="Играть ▶"
                            Margin="0,14,0,0"
                            Padding="18,8"
                            FontSize="13"
                            Foreground="White"
                            Background="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="16"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Подсказка снизу -->
        <TextBlock Text="Скоро здесь появятся ваши любимые игры — выберите любую, чтобы начать"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,24"
                   FontSize="12"
                   Foreground="{DynamicResource MutedTextBrush}"/>
    </Grid>
</UserControl>