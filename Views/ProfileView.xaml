<UserControl x:Class="gamelibrary4.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1120">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="👤 Профиль"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Настройте свой аккаунт"
                       FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Контент в две колонки -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая: аватар и статистика -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CoralBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="24"
                    Margin="0,0,16,0"
                    Opacity="0.95">
                <StackPanel>
                    <!-- Аватар -->
                    <Grid Width="180" Height="180" HorizontalAlignment="Center">
                        <Ellipse Fill="{DynamicResource OverlayWeakBrush}"/>
                        <Ellipse x:Name="AvatarEllipse"
                                 Width="164" Height="164"
                                 Fill="{DynamicResource SurfaceDeepBrush}"
                                 Stroke="{DynamicResource CoralBrush}"
                                 StrokeThickness="2"/>
                        <TextBlock x:Name="AvatarPlaceholder"
                                   Text="👤" FontSize="72"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </Grid>

                    <TextBlock x:Name="LoginText"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"/>

                    <TextBlock x:Name="CreatedText"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>

                    <Button Content="🖼  Загрузить аватар"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,10"
                            Margin="0,18,0,0"
                            Click="UploadAvatarButton_Click"/>

                    <!-- Статистика -->
                    <Border Background="{DynamicResource SurfaceSoftBrush}"
                            CornerRadius="12"
                            Padding="16,12"
                            Margin="0,20,0,0"
                            Opacity="0.9">
                        <StackPanel>
                            <TextBlock Text="📊 Статистика"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Рекордов:" FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock x:Name="RecordsCountText" Text="0" FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource CoralBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="В избранном:" FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock x:Name="FavoritesCountText" Text="0" FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource CoralBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid>
                                <TextBlock Text="Любимая игра:" FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock x:Name="FavoriteGameText" Text="—" FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource CoralBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Правая: смена логина и пароля -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Смена логина -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource CoralBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="24"
                            Margin="0,0,0,16"
                            Opacity="0.95">
                        <StackPanel>
                            <TextBlock Text="✏ Смена логина"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="От 3 символов. Логин должен быть уникальным."
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,4,0,16"/>

                            <TextBlock Text="Новый логин" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="4,0,0,6"/>
                            <Border Background="{DynamicResource OverlayWeakBrush}"
                                    CornerRadius="12" Padding="12,2">
                                <TextBox x:Name="NewLoginBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextBrush}"
                                         CaretBrush="{DynamicResource CoralBrush}"
                                         FontSize="15"
                                         Padding="4,10"/>
                            </Border>

                            <TextBlock x:Name="LoginErrorText"
                                       Foreground="{DynamicResource CoralBrush}"
                                       FontSize="12"
                                       Margin="4,10,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>

                            <Button Content="Сохранить логин"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,10"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Left"
                                    Click="SaveLoginButton_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Смена пароля -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource CoralBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="24"
                            Margin="0,0,0,16"
                            Opacity="0.95">
                        <StackPanel>
                            <TextBlock Text="🔒 Смена пароля"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Пароль от 4 символов."
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,4,0,16"/>

                            <TextBlock Text="Старый пароль" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="4,0,0,6"/>
                            <Border Background="{DynamicResource OverlayWeakBrush}"
                                    CornerRadius="12" Padding="12,2"
                                    Margin="0,0,0,12">
                                <PasswordBox x:Name="OldPasswordBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextBrush}"
                                             CaretBrush="{DynamicResource CoralBrush}"
                                             FontSize="15"
                                             Padding="4,10"/>
                            </Border>

                            <TextBlock Text="Новый пароль" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="4,0,0,6"/>
                            <Border Background="{DynamicResource OverlayWeakBrush}"
                                    CornerRadius="12" Padding="12,2"
                                    Margin="0,0,0,12">
                                <PasswordBox x:Name="NewPasswordBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextBrush}"
                                             CaretBrush="{DynamicResource CoralBrush}"
                                             FontSize="15"
                                             Padding="4,10"/>
                            </Border>

                            <TextBlock Text="Повторите новый пароль" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="4,0,0,6"/>
                            <Border Background="{DynamicResource OverlayWeakBrush}"
                                    CornerRadius="12" Padding="12,2">
                                <PasswordBox x:Name="ConfirmPasswordBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextBrush}"
                                             CaretBrush="{DynamicResource CoralBrush}"
                                             FontSize="15"
                                             Padding="4,10"/>
                            </Border>

                            <TextBlock x:Name="PasswordErrorText"
                                       Foreground="{DynamicResource CoralBrush}"
                                       FontSize="12"
                                       Margin="4,10,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>

                            <Button Content="Сохранить пароль"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,10"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Left"
                                    Click="SavePasswordButton_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>