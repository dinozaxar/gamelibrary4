<UserControl x:Class="gamelibrary4.Views.MusicBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="70" d:DesignWidth="1120"
             Loaded="MusicBarView_Loaded"
             Unloaded="MusicBarView_Unloaded">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CoralBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16,10"
            Margin="24,0,24,16"
            Opacity="0.95">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть: инфо о треке -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        MinWidth="260">
                <TextBlock Text="🎵" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TrackNameText"
                               Text="— папка пуста —"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="TrackInfoText"
                               Text="Положите mp3 в папку музыки"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Центр: кнопки управления -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="PrevButton" Content="⏮"
                        Width="38" Height="38"
                        FontSize="16"
                        Style="{StaticResource FlatButton}"
                        Padding="0"
                        Margin="0,0,6,0"
                        Click="PrevButton_Click"
                        ToolTip="Предыдущий"/>
                <Button x:Name="PlayPauseButton" Content="▶"
                        Width="46" Height="46"
                        FontSize="18"
                        Style="{StaticResource PrimaryButton}"
                        Padding="0"
                        Margin="0,0,6,0"
                        Click="PlayPauseButton_Click"
                        ToolTip="Играть / Пауза"/>
                <Button x:Name="NextButton" Content="⏭"
                        Width="38" Height="38"
                        FontSize="16"
                        Style="{StaticResource FlatButton}"
                        Padding="0"
                        Margin="0,0,6,0"
                        Click="NextButton_Click"
                        ToolTip="Следующий"/>
                <Button x:Name="ShuffleButton" Content="🔀"
                        Width="38" Height="38"
                        FontSize="16"
                        Style="{StaticResource FlatButton}"
                        Padding="0"
                        Click="ShuffleButton_Click"
                        ToolTip="Перемешать"/>
            </StackPanel>

            <!-- Правая часть: громкость -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="16,0,0,0">
                <Button x:Name="MuteButton" Content="🔊"
                        Width="34" Height="34"
                        FontSize="14"
                        Style="{StaticResource FlatButton}"
                        Padding="0"
                        Margin="0,0,8,0"
                        Click="MuteButton_Click"
                        ToolTip="Выключить звук"/>
                <Slider x:Name="VolumeSlider"
                        Width="110"
                        Minimum="0" Maximum="1"
                        Value="0.5"
                        VerticalAlignment="Center"
                        ValueChanged="VolumeSlider_ValueChanged"/>
            </StackPanel>

            <!-- Папка + свернуть -->
            <StackPanel Grid.Column="3" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Content="📁"
                        Width="34" Height="34"
                        FontSize="14"
                        Style="{StaticResource FlatButton}"
                        Padding="0"
                        Margin="0,0,6,0"
                        Click="OpenFolderButton_Click"
                        ToolTip="Открыть папку музыки"/>
                <Button Content="↻"
                        Width="34" Height="34"
                        FontSize="14"
                        Style="{StaticResource FlatButton}"
                        Padding="0"
                        Click="RescanButton_Click"
                        ToolTip="Обновить плейлист"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>