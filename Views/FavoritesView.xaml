<UserControl x:Class="gamelibrary4.Views.FavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1120">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="⭐ Избранное"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Ваши любимые игры"
                       FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Пусто -->
        <Border x:Name="EmptyPanel"
                Grid.Row="1"
                Background="{DynamicResource SurfaceSoftBrush}"
                BorderBrush="{DynamicResource CoralBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Opacity="0.95">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="☆" FontSize="64"
                           Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Пока ничего нет в избранном"
                           FontSize="16"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
                <TextBlock Text="Нажмите ⭐ на любой игре в главном меню"
                           FontSize="13"
                           Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Сетка карточек -->
        <ScrollViewer x:Name="FilledPanel"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <ItemsControl x:Name="FavoritesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Height="200"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource CoralBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Margin="8"
                                Padding="18"
                                Cursor="Hand"
                                Opacity="0.95"
                                MouseLeftButtonUp="Card_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Emoji}"
                                           FontSize="52"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                                <Button Content="Играть ▶"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,14,0,0"
                                        Padding="14,8"
                                        Tag="{Binding Key}"
                                        Click="PlayButton_Click"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>