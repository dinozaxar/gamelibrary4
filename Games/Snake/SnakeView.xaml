<UserControl x:Class="gamelibrary4.Games.Snake.SnakeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="900"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Loaded="SnakeView_Loaded"
             KeyDown="SnakeView_KeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="#662D142C"
                BorderBrush="#55EE4540"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20,14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Очки -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍎" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Очки:" FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="ScoreText" Text="0"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource CoralBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Длина -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🐍" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Длина:" FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="LengthText" Text="3"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource CoralBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Рекорд -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏆" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Рекорд:" FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="BestText" Text="0"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource CoralBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Скорость -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Скорость:" FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="SpeedText" Text="1"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource CoralBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Игровое поле -->
        <Border Grid.Row="1"
                Background="#552D142C"
                BorderBrush="#55801336"
                BorderThickness="1"
                CornerRadius="20"
                Padding="16">
            <Viewbox Stretch="Uniform">
                <Border Background="#FF2D142C"
                        CornerRadius="12"
                        Padding="4">
                    <Canvas x:Name="BoardCanvas"
                            Width="480" Height="480"
                            ClipToBounds="True"/>
                </Border>
            </Viewbox>
        </Border>

        <!-- Нижняя панель -->
        <Border Grid.Row="2"
                Background="#332D142C"
                BorderBrush="#55801336"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,10"
                Margin="0,16,0,0">
            <Grid>
                <TextBlock Text="Управление: ↑ ↓ ← → или W A S D  •  Пробел — пауза"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PauseButton"
                            Content="⏸  Пауза"
                            Style="{StaticResource FlatButton}"
                            Margin="0,0,10,0"
                            Click="PauseButton_Click"/>
                    <Button x:Name="RestartButton"
                            Content="🔄  Заново"
                            Style="{StaticResource PrimaryButton}"
                            Click="RestartButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>