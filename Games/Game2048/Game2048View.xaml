<UserControl x:Class="gamelibrary4.Games.Game2048.Game2048View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="900"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Loaded="View_Loaded"
             KeyDown="View_KeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CoralBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20,14"
                Margin="0,0,0,16"
                Opacity="0.95">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏆" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Очки:" FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="ScoreText" Text="0"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource CoralBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🥇" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Рекорд:" FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="BestText" Text="0"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource CoralBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2"
                        x:Name="RestartButton"
                        Content="🔄  Заново"
                        Style="{StaticResource PrimaryButton}"
                        Click="RestartButton_Click"/>
            </Grid>
        </Border>

        <!-- Игровое поле -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CoralBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="16"
                Opacity="0.95">
            <Viewbox Stretch="Uniform">
                <Grid>
                    <!-- Фон клеток -->
                    <Border x:Name="BoardBackground"
                            Width="440" Height="440"
                            Background="{DynamicResource BoardBgBrush}"
                            CornerRadius="12"/>
                    <!-- Плитки -->
                    <Canvas x:Name="BoardCanvas" Width="440" Height="440"/>
                </Grid>
            </Viewbox>
        </Border>

        <!-- Нижняя панель -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceSoftBrush}"
                BorderBrush="{DynamicResource CoralBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,10"
                Margin="0,16,0,0"
                Opacity="0.95">
            <TextBlock Text="Управление: ↑ ↓ ← → или W A S D  •  R — заново"
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>