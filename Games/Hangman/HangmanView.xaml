<UserControl x:Class="gamelibrary4.Games.Hangman.HangmanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="900"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Loaded="View_Loaded"
             KeyDown="View_KeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CoralBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20,14"
                Margin="0,0,0,16"
                Opacity="0.95">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="❤️" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Жизни:" FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="LivesText" Text="6"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource CoralBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏆" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Побед:" FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="WinsText" Text="0"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource CoralBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2"
                        x:Name="RestartButton"
                        Content="🔄  Новое слово"
                        Style="{StaticResource PrimaryButton}"
                        Click="RestartButton_Click"/>
            </Grid>
        </Border>

        <!-- Основное: слева виселица, справа слово + клавиатура -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Виселица -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CoralBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="16"
                    Margin="0,0,16,0"
                    Opacity="0.95">
                <Viewbox Stretch="Uniform" Width="300" Height="360">
                    <Canvas x:Name="GallowsCanvas" Width="300" Height="360"/>
                </Viewbox>
            </Border>

            <!-- Правая колонка: слово + подсказка + клавиатура -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CoralBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="24"
                    Opacity="0.95">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Подсказка -->
                    <TextBlock Grid.Row="0"
                               x:Name="HintText"
                               Text="Подсказка: животное"
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Слово -->
                    <ItemsControl Grid.Row="1" x:Name="WordPanel"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,30">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="42" Height="52"
                                        Margin="4,0"
                                        BorderBrush="{DynamicResource CoralBrush}"
                                        BorderThickness="0,0,0,3">
                                    <TextBlock Text="{Binding Letter}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Клавиатура -->
                    <ItemsControl Grid.Row="2" x:Name="KeyboardPanel"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel MaxWidth="500" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Letter}"
                                        Tag="{Binding Letter}"
                                        Width="44" Height="44"
                                        Margin="3"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Style="{StaticResource FlatButton}"
                                        Padding="0"
                                        Click="LetterButton_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижняя панель -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceSoftBrush}"
                BorderBrush="{DynamicResource CoralBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,10"
                Margin="0,16,0,0"
                Opacity="0.95">
            <TextBlock Text="Угадывайте буквы русского алфавита. 6 ошибок — проигрыш."
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>