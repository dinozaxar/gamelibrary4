<UserControl x:Class="gamelibrary4.Games.Sudoku.SudokuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1000"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Loaded="View_Loaded"
             KeyDown="View_KeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CoralBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20,14"
                Margin="0,0,0,16"
                Opacity="0.95">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Сложность -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Сложность:" FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="DifficultyCombo"
                              Width="150"
                              SelectedIndex="1"
                              SelectionChanged="DifficultyCombo_SelectionChanged">
                        <ComboBoxItem Content="🟢 Лёгкий"  Tag="Easy"/>
                        <ComboBoxItem Content="🟡 Средний" Tag="Medium"/>
                        <ComboBoxItem Content="🔴 Сложный" Tag="Hard"/>
                    </ComboBox>
                </StackPanel>

                <!-- Статус -->
                <TextBlock Grid.Column="1"
                           x:Name="StatusText"
                           Text=""
                           FontSize="13"
                           Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Кнопки -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄  Новая"
                            Style="{StaticResource PrimaryButton}"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Click="NewGameButton_Click"/>
                    <Button Content="✔  Проверить"
                            Style="{StaticResource FlatButton}"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Click="CheckButton_Click"/>
                    <Button Content="💡  Подсказка"
                            Style="{StaticResource FlatButton}"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Click="HintButton_Click"/>
                    <Button Content="🧹  Очистить"
                            Style="{StaticResource FlatButton}"
                            Padding="14,8"
                            Click="ClearButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Игровое поле + цифровая панель -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Доска -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CoralBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="16"
                    Opacity="0.95">
                <Viewbox Stretch="Uniform">
                    <Grid Width="500" Height="500">
                        <!-- Фон клеток (сетка 9×9) -->
                        <UniformGrid x:Name="BoardGrid" Rows="9" Columns="9"
                                     Background="Transparent"/>

                        <!-- Линии блоков 3×3 -->
                        <Canvas Width="500" Height="500" IsHitTestVisible="False">
                            <Line X1="166" Y1="0"  X2="166" Y2="500" Stroke="{DynamicResource CoralBrush}" StrokeThickness="3"/>
                            <Line X1="333" Y1="0"  X2="333" Y2="500" Stroke="{DynamicResource CoralBrush}" StrokeThickness="3"/>
                            <Line X1="0"   Y1="166" X2="500" Y2="166" Stroke="{DynamicResource CoralBrush}" StrokeThickness="3"/>
                            <Line X1="0"   Y1="333" X2="500" Y2="333" Stroke="{DynamicResource CoralBrush}" StrokeThickness="3"/>
                        </Canvas>
                    </Grid>
                </Viewbox>
            </Border>

            <!-- Цифровая панель -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceSoftBrush}"
                    BorderBrush="{DynamicResource CoralBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="16"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.95">
                <StackPanel>
                    <TextBlock Text="Цифры"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <UniformGrid Rows="3" Columns="3" Width="180" Height="180">
                        <Button Content="1" Tag="1" Style="{StaticResource FlatButton}" Margin="3" FontSize="20" FontWeight="Bold" Click="DigitButton_Click"/>
                        <Button Content="2" Tag="2" Style="{StaticResource FlatButton}" Margin="3" FontSize="20" FontWeight="Bold" Click="DigitButton_Click"/>
                        <Button Content="3" Tag="3" Style="{StaticResource FlatButton}" Margin="3" FontSize="20" FontWeight="Bold" Click="DigitButton_Click"/>
                        <Button Content="4" Tag="4" Style="{StaticResource FlatButton}" Margin="3" FontSize="20" FontWeight="Bold" Click="DigitButton_Click"/>
                        <Button Content="5" Tag="5" Style="{StaticResource FlatButton}" Margin="3" FontSize="20" FontWeight="Bold" Click="DigitButton_Click"/>
                        <Button Content="6" Tag="6" Style="{StaticResource FlatButton}" Margin="3" FontSize="20" FontWeight="Bold" Click="DigitButton_Click"/>
                        <Button Content="7" Tag="7" Style="{StaticResource FlatButton}" Margin="3" FontSize="20" FontWeight="Bold" Click="DigitButton_Click"/>
                        <Button Content="8" Tag="8" Style="{StaticResource FlatButton}" Margin="3" FontSize="20" FontWeight="Bold" Click="DigitButton_Click"/>
                        <Button Content="9" Tag="9" Style="{StaticResource FlatButton}" Margin="3" FontSize="20" FontWeight="Bold" Click="DigitButton_Click"/>
                    </UniformGrid>

                    <Button Content="⌫  Стереть"
                            Style="{StaticResource FlatButton}"
                            Margin="0,12,0,0"
                            Padding="10,8"
                            Click="EraseButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Оверлей генерации -->
            <Border x:Name="GeneratingOverlay"
                    Grid.Column="0" Grid.ColumnSpan="2"
                    Background="#AA000000"
                    CornerRadius="20"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🧩"
                               FontSize="60"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Генерация поля..."
                               FontSize="18"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="На сложном уровне это может занять пару секунд"
                               FontSize="12"
                               Foreground="#CCFFFFFF"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Нижняя подсказка -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceSoftBrush}"
                BorderBrush="{DynamicResource CoralBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,10"
                Margin="0,16,0,0"
                Opacity="0.95">
            <TextBlock Text="Управление: ↑ ↓ ← → — перемещение  •  1–9 — ввод  •  Backspace / Delete — стереть"
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>