<UserControl x:Class="gamelibrary4.Games.TicTacToe.TicTacToeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="900">

    <Grid Margin="24">
        <!-- ==== Экран лобби ==== -->
        <Grid x:Name="LobbyPanel">
            <Border Width="440"
                    Background="#662D142C"
                    BorderBrush="#55EE4540"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="❌⭕" FontSize="42" HorizontalAlignment="Center"/>
                    <TextBlock Text="Крестики-нолики"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="Игра по локальной сети"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,24"/>

                    <!-- Создать комнату -->
                    <Button Content="🏠  Создать комнату"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,12"
                            Margin="0,0,0,10"
                            Click="HostButton_Click"/>

                    <!-- Присоединиться -->
                    <TextBlock Text="IP-адрес хоста" FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="4,16,0,6"/>
                    <Border Background="#33FFFFFF" CornerRadius="12" Padding="12,2" Margin="0,0,0,10">
                        <TextBox x:Name="HostIpBox"
                                 Text="127.0.0.1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource CoralBrush}"
                                 FontSize="15"
                                 Padding="4,10"/>
                    </Border>

                    <Button Content="🔗  Подключиться"
                            Style="{StaticResource FlatButton}"
                            Padding="16,12"
                            Click="JoinButton_Click"/>

                    <!-- Ошибка -->
                    <TextBlock x:Name="LobbyErrorText"
                               Foreground="{StaticResource CoralBrush}"
                               FontSize="12"
                               Margin="4,14,4,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==== Экран игры ==== -->
        <Grid x:Name="GamePanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верх: статус -->
            <Border Grid.Row="0"
                    Background="#662D142C"
                    BorderBrush="#55EE4540"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,14"
                    Margin="0,0,0,16">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎮" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock x:Name="RoleText" Text="Хост"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               Text="Ход: X"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource CoralBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button Content="🚪  Покинуть"
                            Style="{StaticResource FlatButton}"
                            HorizontalAlignment="Right"
                            Padding="12,6"
                            Click="LeaveButton_Click"/>
                </Grid>
            </Border>

            <!-- Центр: доска -->
            <Viewbox Grid.Row="1" Stretch="Uniform">
                <Border Background="#552D142C"
                        BorderBrush="#55801336"
                        BorderThickness="1"
                        CornerRadius="22"
                        Padding="16">
                    <UniformGrid x:Name="BoardGrid" Rows="3" Columns="3"
                                 Width="420" Height="420"/>
                </Border>
            </Viewbox>

            <!-- Низ: инфо -->
            <Border Grid.Row="2"
                    Background="#332D142C"
                    BorderBrush="#55801336"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,10"
                    Margin="0,16,0,0">
                <TextBlock x:Name="InfoText"
                           Text="Ваш ход"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>