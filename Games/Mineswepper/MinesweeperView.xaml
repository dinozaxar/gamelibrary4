<UserControl x:Class="gamelibrary4.Games.Minesweeper.MinesweeperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: счётчики и кнопки -->
        <Border Grid.Row="0"
                Background="#662D142C"
                BorderBrush="#55EE4540"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20,14"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Мины -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💣" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MinesLeftText" Text="15"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource CoralBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" / 15" FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Кнопка Заново -->
                <Button Grid.Column="1"
                        x:Name="RestartButton"
                        Content="🔄  Заново"
                        Style="{StaticResource PrimaryButton}"
                        Click="RestartButton_Click"/>

                <!-- Таймер -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="⏱" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimerText" Text="00:00"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource CoralBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Игровое поле -->
        <Border Grid.Row="1"
                Background="#332D142C"
                BorderBrush="#55801336"
                BorderThickness="1"
                CornerRadius="20"
                Padding="20">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="BoardGrid">
                    <!-- Сгенерируется в code-behind -->
                </Grid>
            </Viewbox>
        </Border>
    </Grid>
</UserControl>